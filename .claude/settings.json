{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(npm start)",
      "Bash(npm run seed)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sqlite3:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(./var/db/**)"
    ]
  }
}
